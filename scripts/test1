#!/bin/sh
set -eu

# test1 <tmpdir> <test.c> [cflags...]
# Compiles and runs a single test variant through the Makefile's `test1`
# target (JSTR_DECL_ONLY, linked against libjstr.so).

if [ $# -lt 2 ]; then
	echo 'usage: test1 <tmpdir> <test.c> [cflags...]' >&2
	exit 2
fi

tmpdir=$1
src=$2
shift 2

cd "$(dirname "$0")/.." || exit
exec make test1 TMPDIR="$tmpdir" SRC="$src" FLAGS="$*"
