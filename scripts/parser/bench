#!/usr/bin/env bash
# Benchmark the C lexer/parser generator against the Python reference pipeline.
#
# Usage: scripts/parser/bench [runs]
#   RUNS=20 scripts/parser/bench
#
# Times are wall-clock milliseconds.  The benchmark pins itself to CPU 0 when
# taskset is available so process-startup noise is comparable for both tools.
set -euo pipefail

path=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$path/../.." && pwd)
bin=$root/build/bin/jstrgen
runs=${1:-${RUNS:-10}}

if [ -z "${JP_BENCH_PINNED:-}" ] && command -v taskset >/dev/null 2>&1; then
	export JP_BENCH_PINNED=1
	exec taskset -c 0 "$0" "$@"
fi

[ -x "$bin" ] || "$path/build" >/dev/null

reg=()
all=()
for f in "$root"/include/*.h; do
	case "$f" in
		*/macros*.h) all+=("$f") ;;
		*) reg+=("$f"); all+=("$f") ;;
	esac
done
while IFS= read -r f; do all+=("$f"); done < <(find "$root/include/internal" -name '*.h' | sort)

tiny=$path/tests/fixtures/blankline.gen.h
musl=$root/include/internal/musl/twoway.h
big=$root/include/string.h

py_gen_func() { (cd "$root/scripts" && python3 ./gen_func.py "$1"); }
py_namespace() {
	if [ "$#" -gt 0 ]; then
		(cd "$root/scripts" && python3 ./namespace_macros.py "$1")
	else
		(cd "$root/scripts" && python3 ./namespace_macros.py)
	fi
}

run_c_big() { "$bin" gen-func "$big" | "$bin" namespace >/dev/null; }
run_py_big() { py_gen_func "$big" | py_namespace >/dev/null; }
run_c_big_gen_only() { "$bin" gen-func "$big" >/dev/null; }
run_py_big_gen_only() { py_gen_func "$big" >/dev/null; }
run_c_musl_ns() { "$bin" namespace "$musl" >/dev/null; }
run_py_musl_ns() { py_namespace "$musl" >/dev/null; }
run_c_tiny() { "$bin" gen-func "$tiny" | "$bin" namespace >/dev/null; }
run_py_tiny() { py_gen_func "$tiny" | py_namespace >/dev/null; }

run_c_regular() {
	for f in "${reg[@]}"; do "$bin" gen-func "$f" | "$bin" namespace >/dev/null; done
}
run_py_regular() {
	for f in "${reg[@]}"; do py_gen_func "$f" | py_namespace >/dev/null; done
}

run_c_all() {
	for f in "${all[@]}"; do
		case "$f" in
			*/internal/*|*/macros*.h) "$bin" namespace "$f" >/dev/null ;;
			*) "$bin" gen-func "$f" | "$bin" namespace >/dev/null ;;
		esac
	done
}
run_py_all() {
	for f in "${all[@]}"; do
		case "$f" in
			*/internal/*|*/macros*.h) py_namespace "$f" >/dev/null ;;
			*) py_gen_func "$f" | py_namespace >/dev/null ;;
		esac
	done
}

now_ns() { date +%s%N; }

# measure <function> <iterations> <batch>
measure() {
	local fn=$1 iterations=$2 batch=$3
	local i j start end ms

	"$fn" >/dev/null 2>&1
	for i in $(seq 1 "$iterations"); do
		start=$(now_ns)
		for j in $(seq 1 "$batch"); do "$fn" >/dev/null 2>&1; done
		end=$(now_ns)
		echo $(((end - start) / batch))
	done | sort -n | awk '
		{ a[NR] = $1; sum += $1 }
		END {
			if (NR == 0) { print "0 0 0 0"; exit }
			med = (NR % 2) ? a[(NR + 1) / 2] : (a[NR / 2] + a[NR / 2 + 1]) / 2
			printf "%.3f %.3f %.3f %.3f\n", a[1]/1e6, med/1e6, a[NR]/1e6, (sum/NR)/1e6
		}'
}

row() {
	local label=$1 cfn=$2 pfn=$3 batch=$4
	local c p
	c=$(measure "$cfn" "$runs" "$batch")
	p=$(measure "$pfn" "$runs" "$batch")
	awk -v label="$label" -v c="$c" -v p="$p" 'BEGIN {
		split(c, C, " "); split(p, P, " ");
		printf "%-28s %8.2f %8.2f %10.2f %8.2f %8.2f %10.2f %8.1fx\n",
			label, C[1], C[2], C[4], P[1], P[2], P[4], P[2]/C[2];
	}'
}

# One-off output sizes for context.
size_c=$( { for f in "${all[@]}"; do
	case "$f" in
		*/internal/*|*/macros*.h) "$bin" namespace "$f" ;;
		*) "$bin" gen-func "$f" | "$bin" namespace ;;
	esac
done; } | wc -c)
size_py=$( { for f in "${all[@]}"; do
	case "$f" in
		*/internal/*|*/macros*.h) py_namespace "$f" ;;
		*) py_gen_func "$f" | py_namespace ;;
	esac
done; } | wc -c)

echo "runs=$runs  cpu=$(taskset -pc $$ 2>/dev/null | sed 's/.*: //')"
echo
printf "%-28s %8s %8s %10s %8s %8s %10s %9s\n" \
	"benchmark" "C min" "C med" "C mean" "Py min" "Py med" "Py mean" "speedup"
printf "%-28s %8s %8s %10s %8s %8s %10s %9s\n" \
	"---------------------------" "-----" "-----" "------" "------" "------" "-------" "-------"

row "tiny (1 function)"        run_c_tiny           run_py_tiny           50
row "string.h gen-func+ns"     run_c_big            run_py_big            1
row "string.h gen-func only"   run_c_big_gen_only   run_py_big_gen_only   1
row "musl namespace only"      run_c_musl_ns        run_py_musl_ns        20
row "regular headers (${#reg[@]})"    run_c_regular  run_py_regular        1
row "all headers (${#all[@]})"        run_c_all      run_py_all            1

echo
printf "generated bytes: C=%s  python=%s  (C/Python=%.1f%%)\n" \
	"$size_c" "$size_py" \
	"$(awk -v c="$size_c" -v p="$size_py" 'BEGIN { print 100*c/p }')"
