#!/bin/sh
# Golden tests for the C lexer/parser header generator.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../../.." && pwd)
bin=${1:-$root/build/bin/jstrgen}

if [ ! -x "$bin" ]; then
	echo "parser tests: missing binary $bin" >&2
	exit 2
fi

rc=0
for f in "$here"/fixtures/*.gen.h; do
	exp=${f%.h}.out
	if ! "$bin" gen-func "$f" | diff -u "$exp" -; then
		echo "FAIL: $(basename "$f")" >&2
		rc=1
	fi
done
for f in "$here"/fixtures/*.ns.h; do
	exp=${f%.h}.out
	if ! "$bin" namespace "$f" | diff -u "$exp" -; then
		echo "FAIL: $(basename "$f")" >&2
		rc=1
	fi
done

if [ "$rc" -eq 0 ]; then
	echo "parser tests: OK"
fi
exit "$rc"
