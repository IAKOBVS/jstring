#!/bin/sh

PS4='' set -e

undefine()
{
	#shellcheck disable=SC2005
	mv "$2" "$2.bak"
	python3 ./check_undefined_macros.py "$1" "$2.bak" >"$2.tmp"
	if cmp -s "$2.tmp" "$2.bak"; then
		rm "$2.tmp"
		mv "$2.bak" "$2"
	else
		mv "$2.tmp" "$2"
		rm "$2.bak"
	fi
}

cd "$(dirname "$0")" || exit
undefine 'JSTR_' ../include/macros.h &
undefine 'JSTR_ARCH' ../include/macros-arch.h &
undefine 'JSTR_(?:OS|ENV)' ../include/macros-os.h &
wait
