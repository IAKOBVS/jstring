#!/bin/sh
# scripts/test-sanitize — build and run the unit tests with ASan/TSan + UBSan.
#
# Each sanitizer combination uses its own build directory so object files and
# shared libraries are never mixed:
#   build-asan-ubsan/
#   build-tsan-ubsan/
#
# Usage: scripts/test-sanitize [asan|tsan|all] [--no-clean] [TEST...]
#
# The default is `all` and a clean build. TEST arguments are passed through to
# scripts/test (e.g. `test-string`).

set -u

ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT" || exit 1

NPROC=$(nproc 2>/dev/null || sysctl -n hw.logicalcpu 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)
SAN=all
CLEAN=1

usage() {
	cat <<'EOF'
Usage: scripts/test-sanitize [asan|tsan|all] [--no-clean] [TEST...]

  asan       ASan + UBSan in build-asan-ubsan/
  tsan       TSan + UBSan in build-tsan-ubsan/
  all        both (default)
  --no-clean reuse the existing sanitizer build directories
EOF
}

while [ $# -gt 0 ]; do
	case $1 in
	asan | tsan | all)
		SAN=$1
		shift
		;;
	--no-clean)
		CLEAN=0
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	--)
		shift
		break
		;;
	*)
		break
		;;
	esac
done

# The SIMD/musl helpers intentionally perform unaligned word loads and
# page-safe vector over-reads. Those are already hidden from ASan via
# JSTR_ATTR_NO_SANITIZE_ADDRESS; UBSan's object-size/alignment checks still
# flag them, so exclude just those two checks for the sanitizer suites.
UBSAN_SKIP='-fno-sanitize=object-size,alignment'

# Make sanitizer reports fatal, not warnings that tests can ignore.
ASAN_OPTIONS=${ASAN_OPTIONS:-detect_leaks=1:abort_on_error=1}
UBSAN_OPTIONS=${UBSAN_OPTIONS:-halt_on_error=1:print_stacktrace=1}
TSAN_OPTIONS=${TSAN_OPTIONS:-halt_on_error=1:second_deadlock_stack=1}
export ASAN_OPTIONS UBSAN_OPTIONS TSAN_OPTIONS

failed=0

run_combo() { # $1 name, $2 sanitizer flags, rest: test filters
	name=$1
	flags=$2
	shift 2
	dir="$ROOT/build-$name"

	echo "== $name ($flags) =="
	if [ "$CLEAN" = 1 ]; then
		make BUILD="$dir" clean >/dev/null || return 1
	fi
	make -j"$NPROC" \
		BUILD="$dir" \
		CFLAGS="-O1 -g -fno-omit-frame-pointer $flags" \
		TEST_SANITIZE="$flags" \
		LDFLAGS="$flags" \
		testbuild || return 1

	JSTR_TEST_BINDIR="$dir/test-bin" \
		JSTR_TEST_LIBDIR="$dir/lib" \
		JSTR_TEST_LOGDIR="$dir/test-logs" \
		JSTR_TEST_TIMES="$dir/test-times" \
		./test-check-fail --no-build --no-parser "$@"
}

want_asan=0
want_tsan=0
case $SAN in
asan) want_asan=1 ;;
tsan) want_tsan=1 ;;
all)
	want_asan=1
	want_tsan=1
	;;
*) echo "test-sanitize: invalid sanitizer: $SAN" >&2; exit 2 ;;
esac

if [ "$want_asan" = 1 ]; then
	run_combo asan-ubsan "-fsanitize=address,undefined $UBSAN_SKIP -fno-sanitize-recover=all -fno-omit-frame-pointer" "$@" || failed=1
fi
if [ "$want_tsan" = 1 ]; then
	run_combo tsan-ubsan "-fsanitize=thread,undefined $UBSAN_SKIP -fno-sanitize-recover=all -fno-omit-frame-pointer" "$@" || failed=1
fi

if [ "$failed" -ne 0 ]; then
	echo 'test-sanitize: FAILED' >&2
	exit 1
fi
echo 'test-sanitize: OK'
